{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "automerge": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "docker-compose": {
    "managerFilePatterns": [
      "/^deploy/docker-compose\\.template$/"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ]
    },
    {
      "matchDepNames": [
        "node"
      ],
      "groupName": "node version"
    },
    {
      "description": "The image labels point to a release mirror; the changelog is in the project repository",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/keycloak/keycloak"
      ],
      "sourceUrl": "https://github.com/keycloak/keycloak"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Node version of the frontend build, kept in step with the CI check",
      "managerFilePatterns": [
        "/^avarc-server-frontend/pom\\.xml$/",
        "/^\\.github/workflows/ci-build\\.yml$/"
      ],
      "matchStrings": [
        "<node\\.version>(?<currentValue>\\d+)</node\\.version>",
        "NODE_VERSION: \"(?<currentValue>\\d+)\""
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ]
}
