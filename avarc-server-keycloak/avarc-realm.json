{
  "realm": "avarc",
  "displayName": "AVARC",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "passwordPolicy": "length(12) and notUsername",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "eventsListeners": [],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "de"
  ],
  "defaultLocale": "en",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "List and read locations"
      },
      {
        "name": "editor",
        "description": "Additionally create, update and delete locations",
        "composite": true,
        "composites": {
          "realm": [
            "viewer"
          ]
        }
      },
      {
        "name": "admin",
        "description": "Additionally manage users and grant roles",
        "composite": true,
        "composites": {
          "realm": [
            "editor"
          ],
          "client": {
            "realm-management": [
              "view-realm",
              "view-clients",
              "view-users",
              "query-users",
              "query-groups",
              "manage-users"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-avarc",
    "description": "Every authenticated user is a viewer",
    "composite": true,
    "composites": {
      "realm": [
        "offline_access",
        "uma_authorization",
        "viewer"
      ],
      "client": {
        "account": [
          "view-profile",
          "manage-account"
        ]
      }
    }
  },
  "clients": [
    {
      "clientId": "avarc-web",
      "name": "AVARC web application",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${AVARC_CLIENT_SECRET}",
      "rootUrl": "${PUBLIC_ORIGIN}",
      "redirectUris": [
        "${PUBLIC_ORIGIN}/*"
      ],
      "webOrigins": [],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PUBLIC_ORIGIN}/*"
      },
      "protocolMappers": [
        {
          "name": "avarc-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "avarc-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}]}"
          ]
        }
      }
    ]
  }
}
