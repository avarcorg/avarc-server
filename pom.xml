<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>org.avarc</groupId>
    <artifactId>avarc-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>avarc-server</name>
    <description>Parent of the avarc-server build</description>

    <modules>
        <module>avarc-server-backend</module>
        <module>avarc-server-frontend</module>
        <module>avarc-server-ingress</module>
        <module>avarc-server-keycloak</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <image.namespace>avarcorg</image.namespace>
        <image.name>${image.namespace}/${image.basename}</image.name>
        <image.source>https://github.com/avarcorg/avarc-server</image.source>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
        <!-- Security fixes newer than the Spring Boot BOM manages
             (spec/SPEC-backend.md); remove once Boot catches up. -->
        <tomcat.version>11.0.27</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
    </properties>

    <profiles>
        <!-- Builds a module's container image with Paketo buildpacks through
             the pack CLI after packaging: ./mvnw -Pwith-docker package. A
             module that has an image declares exec-maven-plugin in its own
             with-docker profile and sets image.path, image.builder,
             image.env and image.env.extra (the values of a pack env option) and
             image.buildpack (the module's own buildpack, which pack needs
             when it is given another one). Every image also gets the Paketo
             health checker, whose program
             /layers/paketo-buildpacks_health-checker/thc/bin/thc the Compose
             health checks run, because the backend image has no shell. -->
        <profile>
            <id>with-docker</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.codehaus.mojo</groupId>
                            <artifactId>exec-maven-plugin</artifactId>
                            <version>${exec-maven-plugin.version}</version>
                            <executions>
                                <execution>
                                    <id>pack-build</id>
                                    <phase>package</phase>
                                    <goals>
                                        <goal>exec</goal>
                                    </goals>
                                    <configuration>
                                        <executable>pack</executable>
                                        <arguments>
                                            <argument>build</argument>
                                            <argument>${image.name}:${project.version}</argument>
                                            <argument>--builder</argument>
                                            <argument>${image.builder}</argument>
                                            <argument>--path</argument>
                                            <argument>${image.path}</argument>
                                            <argument>--env</argument>
                                            <argument>${image.env}</argument>
                                            <argument>--env</argument>
                                            <argument>${image.env.extra}</argument>
                                            <argument>--env</argument>
                                            <argument>BP_OCI_SOURCE=${image.source}</argument>
                                            <argument>--env</argument>
                                            <argument>BP_HEALTH_CHECKER_ENABLED=true</argument>
                                            <argument>--buildpack</argument>
                                            <argument>${image.buildpack}</argument>
                                            <argument>--buildpack</argument>
                                            <argument>paketo-buildpacks/health-checker</argument>
                                            <argument>--tag</argument>
                                            <argument>${image.name}:latest</argument>
                                        </arguments>
                                    </configuration>
                                </execution>
                            </executions>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>
</project>
