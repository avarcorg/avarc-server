# Serves the database on the tailnet. run.sh merges this file into the core
# only on dev and stage and only when the secrets file sets DB_TAILNET=true; it
# adds to the core and overrides nothing of it. See spec/SPEC-deployment.md.
services:
  # docktail serves the database on the tailnet as ${NAME}-db, port 5432.
  db:
    labels:
      - "docktail.service.enable=true"
      - "docktail.service.name=${NAME}-db"
      - "docktail.service.port=5432"
      - "docktail.service.protocol=tcp"
      - "docktail.service.service-port=5432"
