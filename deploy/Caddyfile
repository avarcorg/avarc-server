# One host, path prefixes. See spec/SPEC-ingress.md.
{
	auto_https off
	# TLS is terminated before the ingress (see spec/SPEC-deployment.md); trust
	# the forwarded headers of that hop so that the upstreams see https.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	handle /api/* {
		reverse_proxy backend:8080
	}
	# Keycloak serves under /auth itself. Only the avarc realm and the static
	# resources are public; the admin console, the admin API, the master realm
	# and the management port are not routed. See spec/SPEC-auth.md.
	handle /auth/realms/avarc/* {
		reverse_proxy keycloak:8080
	}
	handle /auth/resources/* {
		reverse_proxy keycloak:8080
	}
	handle /auth/* {
		respond 404
	}
	handle {
		reverse_proxy frontend:3000
	}
}
