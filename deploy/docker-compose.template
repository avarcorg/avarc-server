# Rendered by run.sh with envsubst into docker-compose.yml (gitignored); use
# $$ for a literal dollar. See spec/SPEC-deployment.md.
name: ${NAME}

# Container logs: kept by Docker with rotation, read from the files by the
# collector of the monitoring stack. See spec/SPEC-observability.md.
x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "5"

# Carries only the metrics endpoints; the monitoring stack joins it.
networks:
  metrics:
    name: ${NAME}-metrics

services:
  ingress:
    image: ${IMAGE_NAMESPACE}/avarc-ingress:${INGRESS_VERSION}
    ports:
      - "${INGRESS_PORT}:8080"
    labels:
      - "dd.watch=false"
      - "docktail.service.enable=true"
      - "docktail.service.name=${NAME}"
      - "docktail.service.port=8080"
      - "docktail.service.service-port=443"
    depends_on:
      - backend
      - frontend
      - db
      - keycloak
    networks:
      - default
      - metrics
    healthcheck:
      test:
        - "CMD"
        - "/bin/bash"
        - "-c"
        - "exec 3<>/dev/tcp/127.0.0.1/8081 && printf 'GET /stub_status HTTP/1.0\\r\\n\\r\\n' >&3 && [[ \"$$(head -n 1 <&3)\" == HTTP/*' 200 '* ]]"
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging: *logging
    restart: unless-stopped

  backend:
    image: ${IMAGE_NAMESPACE}/avarc-backend:${BACKEND_VERSION}
    labels:
      - "dd.watch=false"
    environment:
      - SPRING_PROFILES_ACTIVE=${ENVIRONMENT}
      - PUBLIC_ORIGIN=${PUBLIC_ORIGIN}
    # Only the client secret and the database password, not the other secrets.
    volumes:
      - ${SECRETS_RUN_DIR}/KEYCLOAK_CLIENT_SECRET:/run/secrets/KEYCLOAK_CLIENT_SECRET:ro
      - ${SECRETS_RUN_DIR}/POSTGRES_PASSWORD:/run/secrets/POSTGRES_PASSWORD:ro
    depends_on:
      db:
        condition: service_healthy
    logging: *logging
    restart: unless-stopped

  frontend:
    image: ${IMAGE_NAMESPACE}/avarc-frontend:${FRONTEND_VERSION}
    labels:
      - "dd.watch=false"
    environment:
      - BACKEND_URL=http://backend:8080
      - FOOTER_API_DOCS=${FOOTER_API_DOCS}
      - FOOTER_DBTOOL_URL=${FOOTER_DBTOOL_URL}
      - FOOTER_KEYCLOAK_URL=${FOOTER_KEYCLOAK_URL}
    # Any HTTP answer counts, until the frontend has a health endpoint
    # (AVARC-23).
    healthcheck:
      test:
        - "CMD"
        - "/bin/bash"
        - "-c"
        - "exec 3<>/dev/tcp/$$(hostname)/3000 && printf 'GET / HTTP/1.0\\r\\n\\r\\n' >&3 && [[ \"$$(head -n 1 <&3)\" == HTTP/* ]]"
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 20s
    logging: *logging
    restart: unless-stopped

  # Creates Keycloak's own database in the database server, once.
  keycloak-init:
    image: ${UPSTREAM_REGISTRY}/postgis/postgis:17-3.5
    entrypoint: ["sh", "-c"]
    command:
      - |
        export PGPASSWORD="$$(cat /run/secrets/POSTGRES_PASSWORD)"
        echo "SELECT 'CREATE DATABASE keycloak' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'keycloak')\\gexec" | psql -h db -U avarc -d avarc -v ON_ERROR_STOP=1
    volumes:
      - ${SECRETS_RUN_DIR}:/run/secrets:ro
    depends_on:
      db:
        condition: service_healthy
    logging: *logging
    restart: "no"

  # The ingress routes only the avarc realm and its resources (see the
  # nginx.conf of the ingress image). The admin console is reached through docktail on the tailnet
  # as ${NAME}-kc; the loopback port below is for the provisioning script.
  # The container runs as the user that started the project so that it can
  # read the secrets directory, which is closed to others.
  keycloak:
    image: ${IMAGE_NAMESPACE}/avarc-keycloak:${KEYCLOAK_VERSION}
    user: "${RUN_UID}:0"
    environment:
      - PUBLIC_ORIGIN=${PUBLIC_ORIGIN}
      - ADMIN_ORIGIN=${KEYCLOAK_ADMIN_ORIGIN}
    labels:
      - "dd.watch=false"
      - "docktail.service.enable=true"
      - "docktail.service.name=${NAME}-kc"
      - "docktail.service.port=8080"
      - "docktail.service.service-port=443"
    ports:
      - "127.0.0.1:${KEYCLOAK_ADMIN_PORT}:8080"
    volumes:
      - ${SECRETS_RUN_DIR}:/run/secrets:ro
    depends_on:
      keycloak-init:
        condition: service_completed_successfully
    healthcheck:
      test:
        - "CMD"
        - "/bin/bash"
        - "-c"
        - "exec 3<>/dev/tcp/127.0.0.1/9000 && printf 'GET /auth/health/ready HTTP/1.0\\r\\n\\r\\n' >&3 && [[ \"$$(cat <&3)\" == *UP* ]]"
      interval: 5s
      timeout: 5s
      retries: 60
      start_period: 30s
    logging: *logging
    restart: unless-stopped

  db:
    image: ${UPSTREAM_REGISTRY}/postgis/postgis:17-3.5
    # Statements slower than half a second are logged.
    command: ["postgres", "-c", "log_min_duration_statement=500"]
    environment:
      - POSTGRES_USER=avarc
      - POSTGRES_PASSWORD_FILE=/run/secrets/POSTGRES_PASSWORD
      - POSTGRES_DB=avarc
    volumes:
      - ${P}/data/${ENVIRONMENT}/db:/var/lib/postgresql/data
      - ${SECRETS_RUN_DIR}:/run/secrets:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U avarc -d avarc"]
      interval: 2s
      timeout: 3s
      retries: 30
    networks:
      - default
      - metrics
    logging: *logging
    restart: unless-stopped
