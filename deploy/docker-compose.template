# Rendered by run.sh with envsubst into docker-compose.yml (gitignored); use
# $$ for a literal dollar. See spec/SPEC-deployment.md.
name: ${NAME}

services:
  ingress:
    image: ${IMAGE_NAMESPACE}/avarc-ingress:${INGRESS_VERSION}
    ports:
      - "${INGRESS_PORT}:8080"
    labels:
      - "docktail.service.enable=true"
      - "docktail.service.name=${NAME}"
      - "docktail.service.port=8080"
      - "docktail.service.service-port=443"
    depends_on:
      - backend
      - frontend
      - db
      - keycloak
    restart: unless-stopped

  backend:
    image: ${IMAGE_NAMESPACE}/avarc-backend:${BACKEND_VERSION}
    environment:
      - SPRING_PROFILES_ACTIVE=${ENVIRONMENT}
      - PUBLIC_ORIGIN=${PUBLIC_ORIGIN}
    # Only the client secret, not the other secrets.
    volumes:
      - ${SECRETS_RUN_DIR}/KEYCLOAK_CLIENT_SECRET:/run/secrets/KEYCLOAK_CLIENT_SECRET:ro
    restart: unless-stopped

  frontend:
    image: ${IMAGE_NAMESPACE}/avarc-frontend:${FRONTEND_VERSION}
    environment:
      - BACKEND_URL=http://backend:8080
    restart: unless-stopped

  # Creates Keycloak's own database in the database server, once.
  keycloak-init:
    image: postgis/postgis:17-3.5
    entrypoint: ["sh", "-c"]
    command:
      - |
        export PGPASSWORD="$$(cat /run/secrets/POSTGRES_PASSWORD)"
        echo "SELECT 'CREATE DATABASE keycloak' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'keycloak')\\gexec" | psql -h db -U avarc -d avarc -v ON_ERROR_STOP=1
    volumes:
      - ${SECRETS_RUN_DIR}:/run/secrets:ro
    depends_on:
      db:
        condition: service_healthy
    restart: "no"

  # The ingress routes only the avarc realm and its resources (see the
  # nginx.conf of the ingress image). The admin console is reached through docktail on the tailnet
  # as ${NAME}-kc; the loopback port below is for the provisioning script.
  # The container runs as the user that started the project so that it can
  # read the secrets directory, which is closed to others.
  keycloak:
    image: ${IMAGE_NAMESPACE}/avarc-keycloak:${KEYCLOAK_VERSION}
    user: "${RUN_UID}:0"
    environment:
      - PUBLIC_ORIGIN=${PUBLIC_ORIGIN}
      - ADMIN_ORIGIN=${KEYCLOAK_ADMIN_ORIGIN}
    labels:
      - "docktail.service.enable=true"
      - "docktail.service.name=${NAME}-kc"
      - "docktail.service.port=8080"
      - "docktail.service.service-port=443"
    ports:
      - "127.0.0.1:${KEYCLOAK_ADMIN_PORT}:8080"
    volumes:
      - ${SECRETS_RUN_DIR}:/run/secrets:ro
    depends_on:
      keycloak-init:
        condition: service_completed_successfully
    healthcheck:
      test:
        - "CMD"
        - "/bin/bash"
        - "-c"
        - "exec 3<>/dev/tcp/127.0.0.1/9000 && printf 'GET /auth/health/ready HTTP/1.0\\r\\n\\r\\n' >&3 && [[ \"$$(cat <&3)\" == *UP* ]]"
      interval: 5s
      timeout: 5s
      retries: 60
      start_period: 30s
    restart: unless-stopped

  # DB_DOCKTAIL_ENABLE is true only on dev and stage and only when the
  # secrets file sets DB_TAILNET=true (see run.sh); docktail then serves the
  # database on the tailnet as ${NAME}-db, port 5432.
  db:
    image: postgis/postgis:17-3.5
    environment:
      - POSTGRES_USER=avarc
      - POSTGRES_PASSWORD_FILE=/run/secrets/POSTGRES_PASSWORD
      - POSTGRES_DB=avarc
    labels:
      - "docktail.service.enable=${DB_DOCKTAIL_ENABLE}"
      - "docktail.service.name=${NAME}-db"
      - "docktail.service.port=5432"
      - "docktail.service.protocol=tcp"
      - "docktail.service.service-port=5432"
    volumes:
      - ${P}/data/${ENVIRONMENT}/db:/var/lib/postgresql/data
      - ${SECRETS_RUN_DIR}:/run/secrets:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U avarc -d avarc"]
      interval: 2s
      timeout: 3s
      retries: 30
    restart: unless-stopped

  # The web database tool (CloudBeaver). It is in the profile "dbtool", which
  # run.sh enables only on dev and stage and only with DB_TAILNET=true, and
  # docktail serves it on the tailnet as ${NAME}-dbadmin. Its configuration
  # (admin account, connections) is rendered by run.sh into a directory in
  # memory at each start and mounted over the workspace read-only. The
  # container runs as the user that started the project, like keycloak.
  dbtool:
    image: dbeaver/cloudbeaver:26.2.2
    profiles: ["dbtool"]
    user: "${RUN_UID}:0"
    environment:
      - CLOUDBEAVER_APP_ANONYMOUS_ACCESS_ENABLED=false
    labels:
      - "docktail.service.enable=true"
      - "docktail.service.name=${NAME}-dbadmin"
      - "docktail.service.port=8978"
      - "docktail.service.service-port=443"
    volumes:
      - ${P}/data/${ENVIRONMENT}/dbtool:/opt/cloudbeaver/workspace
      - ${DBTOOL_RUN_DIR}/auto.conf:/opt/cloudbeaver/conf/.cloudbeaver.auto.conf:ro
      - ${DBTOOL_RUN_DIR}/data-sources.json:/opt/cloudbeaver/workspace/GlobalConfiguration/.dbeaver/data-sources.json:ro
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped
