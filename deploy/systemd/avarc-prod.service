[Unit]
Description=Avarc (prod)
After=network.target docker.service tailscaled.service
Requires=network.target

[Service]
Type=simple
Restart=always
User=avarc-prod
Group=avarc-prod
Environment=SECRETS=prod
WorkingDirectory=/home/avarc-prod
RuntimeDirectory=avarc-prod
RuntimeDirectoryMode=0700
ExecStart=/home/avarc-prod/run.sh up
ExecStop=/home/avarc-prod/run.sh down
RestartSec=20

[Install]
WantedBy=multi-user.target
